---
import "../../styles/global.css";
import MusicPlayer from "../../components/MusicPlayer.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ThemeInit from "../../components/ThemeInit.astro";
import VercelInsights from "../../components/VercelInsights.astro";

const caseStudyUrl = "https://muhammadirhamrizq-portoweb.vercel.app/projects/salesops-ai/";
const caseStudyDescription =
  "SalesOps AI case study by Muhammad Irham Rizq: Next.js, NestJS, PostgreSQL, FastAPI, Docker, Nginx, Prometheus, Grafana, AI detection, and deployment workflow.";
const caseStudySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${caseStudyUrl}#article`,
      url: caseStudyUrl,
      headline: "SalesOps AI Case Study",
      description: caseStudyDescription,
      image: "https://muhammadirhamrizq-portoweb.vercel.app/assets/kuronashiro-header.jpg",
      author: {
        "@type": "Person",
        "@id": "https://muhammadirhamrizq-portoweb.vercel.app/#person",
        name: "Muhammad Irham Rizq"
      },
      about: { "@id": `${caseStudyUrl}#software` }
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${caseStudyUrl}#software`,
      name: "SalesOps AI",
      description: caseStudyDescription,
      codeRepository: "https://github.com/Kuronashiro/salesops-ai",
      programmingLanguage: ["TypeScript", "Python", "SQL"],
      runtimePlatform: ["Docker", "Node.js", "FastAPI", "PostgreSQL"]
    }
  ]
};

const stack = [
  "Next.js",
  "React",
  "NestJS",
  "Prisma",
  "PostgreSQL",
  "FastAPI",
  "scikit-learn",
  "Docker Compose",
  "Nginx",
  "Prometheus",
  "Grafana",
  "Playwright"
];

const features = [
  "Admin dashboard with revenue, transaction, category, top product, duplicate, and anomaly views.",
  "Searchable and filterable transaction table with CSV import/export workflows.",
  "JWT authentication, role-based access control, protected routes, audit logs, rate limiting, Helmet headers, and restricted CORS.",
  "FastAPI AI service for category prediction using TF-IDF and Linear SVM.",
  "Duplicate candidate detection using normalized text, token similarity, edit distance, and n-gram cosine similarity.",
  "IQR-based price anomaly detection with tuned thresholds for dashboard review.",
  "Docker Compose stack with PostgreSQL, API, dashboard, AI inference, Nginx, Prometheus, and Grafana.",
  "Final docs covering deployment, security, E2E testing, performance, AI detection, and demo readiness."
];

const architectureSteps = [
  {
    name: "Next.js Dashboard",
    type: "Frontend",
    detail: "Admin views, KPI charts, transactions, AI prediction UI"
  },
  {
    name: "NestJS API",
    type: "Backend",
    detail: "JWT auth, RBAC, analytics, audit logs, CSV import/export"
  },
  {
    name: "PostgreSQL",
    type: "Database",
    detail: "Real transaction records, indexes, Prisma schema"
  },
  {
    name: "FastAPI AI",
    type: "AI Service",
    detail: "TF-IDF + Linear SVM category prediction"
  },
  {
    name: "Prometheus + Grafana",
    type: "Monitoring",
    detail: "Metrics, dashboards, service visibility"
  },
  {
    name: "Nginx + Docker",
    type: "Infrastructure",
    detail: "HTTPS reverse proxy and local production-like stack"
  }
];

const demoSnapshots = [
  {
    label: "Dashboard",
    title: "Revenue and transactions",
    detail: "KPI overview, trend chart, category mix, top products"
  },
  {
    label: "API",
    title: "Protected admin flows",
    detail: "JWT auth, RBAC routes, audit logs, import/export"
  },
  {
    label: "AI",
    title: "Detection workspace",
    detail: "Category prediction, duplicate candidates, price anomalies"
  },
  {
    label: "Monitoring",
    title: "Production-like visibility",
    detail: "Prometheus metrics, Grafana panels, health checks"
  }
];

const proof = [
  ["6", "Playwright E2E tests passed"],
  ["8", "API unit tests passed"],
  ["0", "API audit vulnerabilities in final report"],
  ["7", "main Docker services"]
];
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="SalesOps AI Case Study | Muhammad Irham Rizq"
      description={caseStudyDescription}
      path="/projects/salesops-ai/"
      type="article"
      imageAlt="SalesOps AI case study by Muhammad Irham Rizq"
      schema={caseStudySchema}
    />
    <meta name="theme-color" content="#0d1117" />
    <VercelInsights />
  </head>
  <body>
    <SiteHeader caseStudy />

    <main>
      <section class="case-hero">
        <div>
          <p class="section-kicker">Featured Case Study</p>
          <h1>SalesOps AI</h1>
          <p class="hero-role">Kuronashiro Hobby Website | Internship Project</p>
          <p class="hero-copy">
            A production-style sales operations dashboard that combines real
            marketplace transaction data, AI-assisted detection, secure admin
            workflows, and a local DevOps deployment stack.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="https://github.com/Kuronashiro/salesops-ai">Open Repository</a>
            <a class="button secondary" href="/">Back to Portfolio</a>
          </div>
        </div>
        <div class="dashboard-preview" aria-label="SalesOps AI dashboard preview">
          <div class="preview-window-bar">
            <span></span>
            <span></span>
            <span></span>
            <strong>https://localhost</strong>
          </div>
          <div class="dashboard-shell">
            <aside>
              <b>SalesOps</b>
              <span>Overview</span>
              <span>Transactions</span>
              <span>AI Detection</span>
              <span>Audit Logs</span>
            </aside>
            <div class="dashboard-main">
              <div class="mini-kpis">
                <div><strong>437</strong><span>Transactions</span></div>
                <div><strong>21</strong><span>Anomalies</span></div>
                <div><strong>0</strong><span>API audit issues</span></div>
              </div>
              <div class="mini-chart">
                <i style="height: 48%"></i>
                <i style="height: 66%"></i>
                <i style="height: 39%"></i>
                <i style="height: 82%"></i>
                <i style="height: 58%"></i>
                <i style="height: 92%"></i>
              </div>
              <div class="mini-table">
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="case-detail-grid">
        <article>
          <p class="section-kicker">Problem</p>
          <h2>Marketplace data needs structure.</h2>
          <p>
            Kuronashiro Hobby has real sales activity across marketplace channels.
            The project turns spreadsheet-style transaction records into a
            searchable dashboard with analytics, detection, and admin controls.
          </p>
        </article>
        <article>
          <p class="section-kicker">Role</p>
          <h2>Full-stack builder with DevOps ownership.</h2>
          <p>
            The work covers dashboard UI, backend API, database model, AI
            inference service, local deployment, monitoring, security checks,
            testing, and project documentation.
          </p>
        </article>
      </section>

      <section class="snapshots" id="preview" aria-labelledby="snapshot-title">
        <div class="section-heading">
          <p class="section-kicker">Preview</p>
          <h2 id="snapshot-title">What the main project feels like in use.</h2>
        </div>
        <div class="snapshot-grid">
          {demoSnapshots.map((snapshot) => (
            <article>
              <span>{snapshot.label}</span>
              <h3>{snapshot.title}</h3>
              <p>{snapshot.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="tech-stack-wall" aria-labelledby="case-stack">
        <div class="section-heading">
          <p class="section-kicker">Stack</p>
          <h2 id="case-stack">Tools used in this project.</h2>
        </div>
        <div class="stack-badges wide">
          {stack.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="architecture" id="architecture" aria-labelledby="architecture-title">
        <div class="section-heading">
          <p class="section-kicker">System Architecture</p>
          <h2 id="architecture-title">How the SalesOps AI stack moves data.</h2>
        </div>
        <div class="architecture-flow case-flow" aria-label="SalesOps AI service architecture">
          {architectureSteps.map((step, index) => (
            <article class="architecture-node" style={`--step: ${index}`}>
              <span>{step.type}</span>
              <h3>{step.name}</h3>
              <p>{step.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-detail-grid">
        <article>
          <p class="section-kicker">Features</p>
          <h2>What the system does.</h2>
          <ul class="detail-list">
            {features.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>
        <article id="proof">
          <p class="section-kicker">Proof</p>
          <h2>Testing, security, and readiness.</h2>
          <div class="case-metrics">
            {proof.map(([value, label]) => (
              <div>
                <strong>{value}</strong>
                <span>{label}</span>
              </div>
            ))}
          </div>
          <p>
            The repository includes final report notes for E2E testing, security
            hardening, deployment guide, performance optimization, and AI
            detection behavior.
          </p>
        </article>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <strong>SalesOps AI</strong>
        <span>Case study by Muhammad Irham Rizq</span>
      </div>
      <div>
        <a href="/">Portfolio</a>
        <a href="https://github.com/Kuronashiro/salesops-ai">GitHub</a>
        <a href="/files/cv-muhammad-irham-rizq-2025.pdf">CV</a>
      </div>
    </footer>
    <MusicPlayer />
  </body>
</html>
